{
  "name": "blindsweeper",
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "npm run dev --prefix frontend -- --host",
    "build": "npm run build --prefix frontend",
    "install:all": "npm install && npm install --prefix frontend",
    "ci:all": "npm ci --prefix frontend",
    "generate-static-assets": "node --env-file=./.env scripts/generateStaticAssets.mjs",
    "lint:frontend": "npm run lint --prefix frontend",
    "lint:bash": "shellcheck -x --severity=warning scripts/*.sh",
    "lint:workflows": "actionlint && yamllint .github/workflows/ && shellcheck -x --severity=warning scripts/*.sh",
    "test:frontend": "npm run test --prefix frontend",
    "test:e2e": "npm run test:e2e --prefix frontend -- --project=mobile-chrome",
    "test": "npm run test:frontend",
    "lint": "npm run lint:frontend",
    "lint:fix": "npm run lint:frontend -- -- --fix",
    "tsc:frontend": "npm run tsc --prefix frontend",
    "tsc": "npm run tsc:frontend",
    "verify": "npm run lint && npm run tsc && npm test",
    "bump-version": "bash scripts/bump-version.sh"
  }
}
