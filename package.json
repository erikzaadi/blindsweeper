{
  "name": "blindsweeper",
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "npm run dev --prefix frontend -- --host",
    "build": "npm run build --prefix frontend",
    "install:all": "npm install && npm install --prefix frontend",
    "ci:all": "npm ci --prefix frontend",
    "generate-static-assets": "node --env-file=./.env scripts/generateStaticAssets.mjs",
    "lint:frontend": "npm run lint --prefix frontend",
    "test:frontend": "npm run test --prefix frontend",
    "test": "npm run test:frontend",
    "lint": "npm run lint:frontend",
    "tsc:frontend": "npm run tsc --prefix frontend",
    "tsc": "npm run tsc:frontend",
    "verify": "npm run lint && npm run tsc && npm test"
  }
}
